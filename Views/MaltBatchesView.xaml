<UserControl x:Class="BeerZdec.Views.MaltBatchesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BeerZdec.Views"
             mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Таблица партий солода -->
        <GroupBox Grid.Column="0" Header="Партии готового солода" Margin="0,0,10,0">
            <DataGrid ItemsSource="{Binding MaltBatches}" 
                      SelectedItem="{Binding SelectedBatch}"
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding MaltBatch_ID}" Width="50"/>
                    <DataGridTextColumn Header="ID Процесса" Binding="{Binding MaltBatch_MaltProcess}" Width="100"/>
                    <DataGridTextColumn Header="Количество (кг)" Binding="{Binding MaltBatch_Quantity}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Форма редактирования -->
        <GroupBox Grid.Column="1" Header="Редактирование" Margin="10,0,0,0">
            <StackPanel Margin="10">
                <TextBlock Text="Процесс солодоращения:" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding Processes}" 
                         SelectedItem="{Binding SelectedProcess}"
                         DisplayMemberPath="MaltProcess_ID"
                         Margin="0,0,0,15" Padding="5"/>

                <TextBlock Text="Количество (кг):" Margin="0,0,0,5"/>
                <TextBox Text="{Binding EditQuantity, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0,0,0,20" Padding="5"/>

                <Button Content="Добавить" Command="{Binding AddCommand}" Padding="10,5" Margin="0,0,0,10" Background="#2196F3" Foreground="White"/>
                <Button Content="Сохранить" Command="{Binding SaveCommand}" Padding="10,5" Margin="0,0,0,10" Background="#4CAF50" Foreground="White"/>
                <Button Content="Удалить" Command="{Binding DeleteCommand}" Padding="10,5" Margin="0,0,0,10" Background="#f44336" Foreground="White"/>
                <Button Content="Отмена" Command="{Binding CancelCommand}" Padding="10,5" Background="#9E9E9E" Foreground="White"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>