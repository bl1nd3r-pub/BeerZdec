<UserControl x:Class="BeerZdec.Views.StorageMoveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BeerZdec.Views"
             mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Таблица перемещений -->
        <GroupBox Grid.Column="0" Header="Журнал перемещений" Margin="0,0,10,0">
            <DataGrid ItemsSource="{Binding StorageMoves}" 
                      SelectedItem="{Binding SelectedMove}"
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding StorageMoves_Zapis_ID}" Width="50"/>
                    <DataGridTextColumn Header="Партия (ID)" Binding="{Binding StorageMoves_GrainBatch}" Width="80"/>
                    <DataGridTextColumn Header="Откуда (ID)" Binding="{Binding StorageMoves_FromStorage}" Width="80"/>
                    <DataGridTextColumn Header="Куда (ID)" Binding="{Binding StorageMoves_ToStorage}" Width="80"/>
                    <DataGridTextColumn Header="Вес (кг)" Binding="{Binding StorageMoves_Weight}" Width="80"/>
                    <DataGridTextColumn Header="Сотрудник" Binding="{Binding StorageMoves_MovedByNavigation.Emp_LastName}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Форма редактирования -->
        <GroupBox Grid.Column="1" Header="Редактирование" Margin="10,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">
                    <TextBlock Text="Партия зерна:" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding GrainBatches}" 
                             SelectedItem="{Binding SelectedBatch}"
                             DisplayMemberPath="GB_ID"
                             Margin="0,0,0,10" Padding="5"/>

                    <TextBlock Text="Откуда (Ячейка):" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding StorageCells}" 
                             SelectedItem="{Binding SelectedFromCell}"
                             DisplayMemberPath="Storage_ID"
                             Margin="0,0,0,10" Padding="5"/>

                    <TextBlock Text="Куда (Ячейка):" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding StorageCells}" 
                             SelectedItem="{Binding SelectedToCell}"
                             DisplayMemberPath="Storage_ID"
                             Margin="0,0,0,15" Padding="5"/>

                    <TextBlock Text="Сотрудник:" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding Employees}" 
                             SelectedItem="{Binding SelectedEmployee}"
                             DisplayMemberPath="Emp_LastName"
                             Margin="0,0,0,15" Padding="5"/>

                    <TextBlock Text="Вес (кг):" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding EditWeight, UpdateSourceTrigger=PropertyChanged}" 
                             Margin="0,0,0,20" Padding="5"/>

                    <Button Content="Добавить" Command="{Binding AddCommand}" Padding="10,5" Margin="0,0,0,10" Background="#2196F3" Foreground="White"/>
                    <Button Content="Сохранить" Command="{Binding SaveCommand}" Padding="10,5" Margin="0,0,0,10" Background="#4CAF50" Foreground="White"/>
                    <Button Content="Удалить" Command="{Binding DeleteCommand}" Padding="10,5" Margin="0,0,0,10" Background="#f44336" Foreground="White"/>
                    <Button Content="Отмена" Command="{Binding CancelCommand}" Padding="10,5" Background="#9E9E9E" Foreground="White"/>
                </StackPanel>
            </ScrollViewer>
        </GroupBox>
    </Grid>
</UserControl>