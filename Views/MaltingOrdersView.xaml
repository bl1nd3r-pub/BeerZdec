<UserControl x:Class="BeerZdec.Views.MaltingOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BeerZdec.Views"
             mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Таблица заказов -->
        <GroupBox Grid.Column="0" Header="Заказы на солодоращение" Margin="0,0,10,0">
            <DataGrid ItemsSource="{Binding MaltingOrders}" 
                      SelectedItem="{Binding SelectedOrder}"
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding MaltingOrder_ID}" Width="50"/>
                    <DataGridTextColumn Header="Дата создания" Binding="{Binding MaltingOrder_СreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="150"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding MaltingOrder_Status}" Width="200"/>
                    <DataGridTextColumn Header="Целевой тип солода" Binding="{Binding MaltingOrder_TargetMaltType}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Форма редактирования -->
        <GroupBox Grid.Column="1" Header="Редактирование" Margin="10,0,0,0">
            <StackPanel Margin="10">
                <TextBlock Text="Дата создания:" Margin="0,0,0,5"/>
                <DatePicker SelectedDate="{Binding EditCreatedAt, UpdateSourceTrigger=PropertyChanged}" 
                           Margin="0,0,0,15" Padding="5"/>

                <TextBlock Text="Статус заказа:" Margin="0,0,0,5"/>
                <TextBox Text="{Binding EditStatus, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0,0,0,10" Padding="5"/>

                <TextBlock Text="Целевой тип солода:" Margin="0,0,0,5"/>
                <TextBox Text="{Binding EditTargetMaltType, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0,0,0,20" Padding="5"/>

                <Button Content="Добавить" 
                        Command="{Binding AddCommand}"
                        Padding="10,5" Margin="0,0,0,10"
                        Background="#2196F3" Foreground="White"/>

                <Button Content="Сохранить" 
                        Command="{Binding SaveCommand}"
                        Padding="10,5" Margin="0,0,0,10"
                        Background="#4CAF50" Foreground="White"/>

                <Button Content="Удалить" 
                        Command="{Binding DeleteCommand}"
                        Padding="10,5" Margin="0,0,0,10"
                        Background="#f44336" Foreground="White"/>

                <Button Content="Отмена" 
                        Command="{Binding CancelCommand}"
                        Padding="10,5"
                        Background="#9E9E9E" Foreground="White"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>