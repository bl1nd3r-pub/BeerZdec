<UserControl x:Class="BeerZdec.Views.GrainBatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BeerZdec.Views"
             mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Таблица партий -->
        <GroupBox Grid.Column="0" Header="Партии зерна" Margin="0,0,10,0">
            <DataGrid ItemsSource="{Binding GrainBatches}" 
                      SelectedItem="{Binding SelectedBatch}"
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding GB_ID}" Width="50"/>
                    <DataGridTextColumn Header="Урожай" Binding="{Binding GB_HarvestNavigation.HarvestEvent_Date, StringFormat={}{0:dd.MM.yyyy}}" Width="100"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding GB_StatusNavigation.GBStatus_Name}" Width="120"/>
                    <DataGridTextColumn Header="Качество" Binding="{Binding GB_QualGradeNavigation.GBQualGrade_Name}" Width="120"/>
                    <DataGridTextColumn Header="Вес (кг)" Binding="{Binding GB_WeightReceived}" Width="100"/>
                    <DataGridTextColumn Header="Влажность %" Binding="{Binding GB_Moisture}" Width="80"/>
                    <DataGridTextColumn Header="Примеси %" Binding="{Binding GB_ForeignMatter}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Форма редактирования -->
        <GroupBox Grid.Column="1" Header="Редактирование" Margin="10,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="10">
                    <TextBlock Text="Урожай (событие уборки):" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding HarvestEvents}" 
                             SelectedItem="{Binding SelectedHarvest}"
                             DisplayMemberPath="HarvestEvent_Date"
                             Margin="0,0,0,10" Padding="5"/>

                    <TextBlock Text="Статус:" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding GBStatuses}" 
                             SelectedItem="{Binding SelectedStatus}"
                             DisplayMemberPath="GBStatus_Name"
                             Margin="0,0,0,10" Padding="5"/>

                    <TextBlock Text="Класс качества:" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding GBQualGrades}" 
                             SelectedItem="{Binding SelectedGrade}"
                             DisplayMemberPath="GBQualGrade_Name"
                             Margin="0,0,0,15" Padding="5"/>

                    <TextBlock Text="Вес принятый (кг):" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding EditWeightReceived, UpdateSourceTrigger=PropertyChanged}" 
                             Margin="0,0,0,10" Padding="5"/>

                    <TextBlock Text="Влажность (%):" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding EditMoisture, UpdateSourceTrigger=PropertyChanged}" 
                             Margin="0,0,0,10" Padding="5"/>

                    <TextBlock Text="Примеси (%):" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding EditForeignMatter, UpdateSourceTrigger=PropertyChanged}" 
                             Margin="0,0,0,20" Padding="5"/>

                    <Button Content="Добавить" Command="{Binding AddCommand}" Padding="10,5" Margin="0,0,0,10" Background="#2196F3" Foreground="White"/>
                    <Button Content="Сохранить" Command="{Binding SaveCommand}" Padding="10,5" Margin="0,0,0,10" Background="#4CAF50" Foreground="White"/>
                    <Button Content="Удалить" Command="{Binding DeleteCommand}" Padding="10,5" Margin="0,0,0,10" Background="#f44336" Foreground="White"/>
                    <Button Content="Отмена" Command="{Binding CancelCommand}" Padding="10,5" Background="#9E9E9E" Foreground="White"/>
                </StackPanel>
            </ScrollViewer>
        </GroupBox>
    </Grid>
</UserControl>