<UserControl x:Class="BeerZdec.Views.VarietyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BeerZdec.Views"
             mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Таблица сортов -->
        <GroupBox Grid.Column="0" Header="Сорта зерна" Margin="0,0,10,0">
            <DataGrid ItemsSource="{Binding Varieties}" 
                      SelectedItem="{Binding SelectedVariety}"
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Variety_ID}" Width="50"/>
                    <DataGridTextColumn Header="Название (RU)" Binding="{Binding Variety_NameRu}" Width="*"/>
                    <DataGridTextColumn Header="Название (Lat)" Binding="{Binding Variety_NameLatin}" Width="*"/>
                    <!-- Проверь имя свойства навигации в модели Grain! -->
                    <DataGridTextColumn Header="Зерно" Binding="{Binding Variety_GrainNavigation.Grain_NameRu}" Width="150"/>
                    <DataGridTextColumn Header="Группа спелости" Binding="{Binding Variety_MaturityGroup}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Форма редактирования -->
        
        <GroupBox Grid.Column="1" Header="Редактирование" Margin="10,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="10">
                    <TextBlock Text="Название (RU):" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding EditNameRu, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="5"/>

                    <TextBlock Text="Название (Lat):" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding EditNameLatin, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="5"/>

                    <TextBlock Text="Тип зерна:" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding Grains}" 
                                SelectedItem="{Binding SelectedGrain}"
                                DisplayMemberPath="Grain_NameRu" 
                                Margin="0,0,0,10" Padding="5"/>

                    <TextBlock Text="Группа спелости:" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding EditMaturityGroup, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="5"/>

                    <TextBlock Text="Назначение:" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding EditMaltingPurpose, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15" Padding="5"/>

                    <Button Content="Добавить" Command="{Binding AddCommand}" Padding="10,5" Margin="0,0,0,10" Background="#2196F3" Foreground="White"/>
                    <Button Content="Сохранить" Command="{Binding SaveCommand}" Padding="10,5" Margin="0,0,0,10" Background="LightGreen" Foreground="White"/>
                    <Button Content="Удалить" Command="{Binding DeleteCommand}" Padding="10,5" Margin="0,0,0,10" Background="#f44336" Foreground="White"/>
                    <Button Content="Отмена" Command="{Binding CancelCommand}" Padding="10,5" Background="#9E9E9E" Foreground="White"/>
                </StackPanel>
            </ScrollViewer>
        </GroupBox>
        
    </Grid>
</UserControl>