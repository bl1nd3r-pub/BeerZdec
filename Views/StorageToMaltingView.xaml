<UserControl x:Class="BeerZdec.Views.StorageToMaltingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BeerZdec.Views"
             mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Таблица отгрузок -->
        <GroupBox Grid.Column="0" Header="Отгрузка зерна на солодовню" Margin="0,0,10,0">
            <DataGrid ItemsSource="{Binding StorageToMaltings}" 
                      SelectedItem="{Binding SelectedRecord}"
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding STM_Zapis_ID}" Width="50"/>
                    <DataGridTextColumn Header="Заказ (ID)" Binding="{Binding STM_MaltOrderNavigation.MaltingOrder_ID}" Width="*"/>
                    <DataGridTextColumn Header="Ячейка (ID)" Binding="{Binding STM_Storage}" Width="80"/>
                    <DataGridTextColumn Header="Количество" Binding="{Binding STM_Quantity}" Width="100"/>
                    <DataGridTextColumn Header="Дата" Binding="{Binding STM_Datetime, StringFormat={}{0:dd.MM.yyyy}}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Форма редактирования -->
        <GroupBox Grid.Column="1" Header="Редактирование" Margin="10,0,0,0">
            <StackPanel Margin="10">
                <TextBlock Text="Заказ на солодоращение:" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding MaltingOrders}" 
                         SelectedItem="{Binding SelectedOrder}"
                         DisplayMemberPath="MaltingOrder_ID"
                         Margin="0,0,0,10" Padding="5"/>

                <TextBlock Text="Ячейка хранения (откуда):" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding StorageCells}" 
                         SelectedItem="{Binding SelectedCell}"
                         DisplayMemberPath="Storage_ID"
                         Margin="0,0,0,15" Padding="5"/>

                <TextBlock Text="Количество:" Margin="0,0,0,5"/>
                <TextBox Text="{Binding EditQuantity, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0,0,0,10" Padding="5"/>

                <TextBlock Text="Дата отгрузки:" Margin="0,0,0,5"/>
                <DatePicker SelectedDate="{Binding EditDatetime, UpdateSourceTrigger=PropertyChanged}" 
                            Margin="0,0,0,20" Padding="5"/>

                <Button Content="Добавить" Command="{Binding AddCommand}" Padding="10,5" Margin="0,0,0,10" Background="#2196F3" Foreground="White"/>
                <Button Content="Сохранить" Command="{Binding SaveCommand}" Padding="10,5" Margin="0,0,0,10" Background="#4CAF50" Foreground="White"/>
                <Button Content="Удалить" Command="{Binding DeleteCommand}" Padding="10,5" Margin="0,0,0,10" Background="#f44336" Foreground="White"/>
                <Button Content="Отмена" Command="{Binding CancelCommand}" Padding="10,5" Background="#9E9E9E" Foreground="White"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>