<UserControl x:Class="BeerZdec.Views.MaltProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BeerZdec.Views"
             mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Таблица процессов -->
        <GroupBox Grid.Column="0" Header="Процессы солодоращения" Margin="0,0,10,0">
            <DataGrid ItemsSource="{Binding Processes}" 
                      SelectedItem="{Binding SelectedProcess}"
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding MaltProcess_ID}" Width="50"/>
                    <DataGridTextColumn Header="Заказ" Binding="{Binding MaltProcess_MaltOrderNavigation.MaltingOrder_ID}" Width="80"/>
                    <DataGridTextColumn Header="Линия" Binding="{Binding MaltProcess_MaltLineNavigation.MaltingLine_ID}" Width="150"/>
                    <DataGridTextColumn Header="Технолог" Binding="{Binding MaltProcess_TechnologistNavigation.Emp_LastName}" Width="*"/>
                    <DataGridTextColumn Header="Начало" Binding="{Binding MaltProcess_StartTime, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="150"/>
                    <DataGridTextColumn Header="Конец" Binding="{Binding MaltProcess_EndTime, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Форма редактирования -->
        <GroupBox Grid.Column="1" Header="Редактирование" Margin="10,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">
                    <TextBlock Text="Заказ на солодоращение:" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding Orders}" 
                             SelectedItem="{Binding SelectedOrder}"
                             DisplayMemberPath="MaltingOrder_ID"
                             Margin="0,0,0,10" Padding="5"/>

                    <TextBlock Text="Линия солодовни:" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding Lines}" 
                             SelectedItem="{Binding SelectedLine}"
                             DisplayMemberPath="MaltingLine_ID"
                             Margin="0,0,0,10" Padding="5"/>

                    <TextBlock Text="Технолог:" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding Employees}" 
                             SelectedItem="{Binding SelectedTechnologist}"
                             DisplayMemberPath="Emp_LastName"
                             Margin="0,0,0,15" Padding="5"/>

                    <TextBlock Text="Время начала:" Margin="0,0,0,5"/>
                    <DatePicker SelectedDate="{Binding EditStartTime, UpdateSourceTrigger=PropertyChanged}" 
                               Margin="0,0,0,10" Padding="5"/>

                    <TextBlock Text="Время окончания:" Margin="0,0,0,5"/>
                    <DatePicker SelectedDate="{Binding EditEndTime, UpdateSourceTrigger=PropertyChanged}" 
                               Margin="0,0,0,20" Padding="5"/>

                    <Button Content="Добавить" Command="{Binding AddCommand}" Padding="10,5" Margin="0,0,0,10" Background="#2196F3" Foreground="White"/>
                    <Button Content="Сохранить" Command="{Binding SaveCommand}" Padding="10,5" Margin="0,0,0,10" Background="#4CAF50" Foreground="White"/>
                    <Button Content="Удалить" Command="{Binding DeleteCommand}" Padding="10,5" Margin="0,0,0,10" Background="#f44336" Foreground="White"/>
                    <Button Content="Отмена" Command="{Binding CancelCommand}" Padding="10,5" Background="#9E9E9E" Foreground="White"/>
                </StackPanel>
            </ScrollViewer>
        </GroupBox>
    </Grid>
</UserControl>