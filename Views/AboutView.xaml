<UserControl x:Class="BeerZdec.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BeerZdec.Views"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="20">
        <Grid HorizontalAlignment="Center" Background="White">
            <StackPanel Width="500" Margin="20">
                <TextBlock Text="О программе" FontSize="28" FontWeight="Bold" 
                           HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <!-- Текст из файла -->
                <TextBlock Text="{Binding AboutText}" 
                           FontSize="12" 
                           TextWrapping="Wrap"
                           Margin="0,0,0,20"
                           LineHeight="4"/>

                <!-- Разделитель -->
                <Separator Margin="0,10"/>

                <!-- Копирайт -->
                <TextBlock Text="© BeerZdec, 2026. Все права защищены." 
                           FontSize="10" 
                           Foreground="Gray"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
