<UserControl x:Class="BeerZdec.Views.CrudeSuppliesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BeerZdec.Views"
             mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Таблица поставок -->
        <GroupBox Grid.Column="0" Header="Поставки сырья" Margin="0,0,10,0">
            <DataGrid ItemsSource="{Binding Supplies}" 
                      SelectedItem="{Binding SelectedSupply}"
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding CrudeSupply_ID}" Width="50"/>
                    <DataGridTextColumn Header="Поставщик" Binding="{Binding CrudeSupply_SupplierNavigation.Supplier_Name}" Width="*"/>
                    <DataGridTextColumn Header="Тип сырья" Binding="{Binding CrudeSupply_CrudeNavigation.SuppliableCrude_Name}" Width="*"/>
                    <DataGridTextColumn Header="Количество" Binding="{Binding CrudeSupply_Amount}" Width="100"/>
                    <DataGridTextColumn Header="Дата" Binding="{Binding CrudeSupply_Datetime, StringFormat={}{0:dd.MM.yyyy}}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Форма редактирования -->
        <GroupBox Grid.Column="1" Header="Редактирование" Margin="10,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">
                    <TextBlock Text="Поставщик:" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding Suppliers}" 
                             SelectedItem="{Binding SelectedSupplier}"
                             DisplayMemberPath="Supplier_Name"
                             Margin="0,0,0,10" Padding="5"/>

                    <TextBlock Text="Тип сырья:" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding CrudeTypes}" 
                             SelectedItem="{Binding SelectedCrudeType}"
                             DisplayMemberPath="SuppliableCrude_Name"
                             Margin="0,0,0,15" Padding="5"/>

                    <TextBlock Text="Количество:" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding EditAmount, UpdateSourceTrigger=PropertyChanged}" 
                             Margin="0,0,0,10" Padding="5"/>

                    <TextBlock Text="Дата поставки:" Margin="0,0,0,5"/>
                    <DatePicker SelectedDate="{Binding EditDatetime, UpdateSourceTrigger=PropertyChanged}" 
                                Margin="0,0,0,20" Padding="5"/>

                    <Button Content="Добавить" Command="{Binding AddCommand}" Padding="10,5" Margin="0,0,0,10" Background="#2196F3" Foreground="White"/>
                    <Button Content="Сохранить" Command="{Binding SaveCommand}" Padding="10,5" Margin="0,0,0,10" Background="#4CAF50" Foreground="White"/>
                    <Button Content="Удалить" Command="{Binding DeleteCommand}" Padding="10,5" Margin="0,0,0,10" Background="#f44336" Foreground="White"/>
                    <Button Content="Отмена" Command="{Binding CancelCommand}" Padding="10,5" Background="#9E9E9E" Foreground="White"/>
                </StackPanel>
            </ScrollViewer>
        </GroupBox>
    </Grid>
</UserControl>