<UserControl x:Class="BeerZdec.Views.AdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:BeerZdec.Converters"
             mc:Ignorable="d">
    <UserControl.Resources>
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Список пользователей -->
        <GroupBox Grid.Column="0" Header="Пользователи" Margin="0,0,10,0">
            <DataGrid ItemsSource="{Binding Users}" 
                      SelectedItem="{Binding SelectedUser}"
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                    <DataGridTextColumn Header="Логин" Binding="{Binding UsLogin}" Width="*"/>
                    <DataGridTextColumn Header="Роль" Binding="{Binding RoleNavigation.RoleName}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Форма редактирования -->
        <GroupBox Grid.Column="1" Header="Редактирование"
                  Margin="10,0,0,0"
                  Visibility="{Binding HasSelectedUser, Converter={StaticResource BoolToVis}}">
            
            <StackPanel Margin="10">
                <TextBlock Text="Логин:" Margin="0,0,0,5"/>
                <TextBox Text="{Binding EditLogin, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0,0,0,15" Padding="5"/>

                <TextBlock Text="Роль:" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding Roles}" 
                    SelectedValue="{Binding EditRoleId}"
                    SelectedValuePath="UserRoleId"
                    DisplayMemberPath="RoleName"
                    Margin="0,0,0,20"/>

                <Button Content="Сохранить" 
                    Command="{Binding SaveUserCommand}" 
                    IsEnabled="{Binding CanSave}"
                    Padding="10,5" 
                    Background="LightGreen"/>

                <TextBlock Text="{Binding HintMessage}" 
                    Foreground="Red" 
                    Margin="0,10,0,0" 
                    TextWrapping="Wrap"/>

                <Button Content="❌ Отмена" 
                        Command="{Binding CancelEditCommand}"
                        Padding="10,5"
                        Background="#f44336" Foreground="White"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>