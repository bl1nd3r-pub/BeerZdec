<UserControl x:Class="BeerZdec.Views.HarvestEventView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BeerZdec.Views"
             mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <GroupBox Grid.Column="0" Header="События уборки урожая" Margin="0,0,10,0">
            <DataGrid ItemsSource="{Binding HarvestEvents}" 
                      SelectedItem="{Binding SelectedEvent}"
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding HarvestEvent_ID}" Width="50"/>
                    <DataGridTextColumn Header="Дата" Binding="{Binding HarvestEvent_Date, StringFormat={}{0:dd.MM.yyyy}}" Width="100"/>
                    <DataGridTextColumn Header="Участок" Binding="{Binding HarvestEvent_SowPlotNavigation.SowingPlot_ID, StringFormat='Участок #{0}'}" Width="100"/>
                    <DataGridTextColumn Header="Вес (кг)" Binding="{Binding HarvestEvent_GrossWeight}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <GroupBox Grid.Column="1" Header="Редактирование" Margin="10,0,0,0">
            <StackPanel Margin="10">
                <TextBlock Text="Дата уборки:" Margin="0,0,0,5"/>
                <DatePicker SelectedDate="{Binding EditDate, UpdateSourceTrigger=PropertyChanged}" 
                            Margin="0,0,0,15" Padding="5"/>

                <TextBlock Text="Посевной участок:" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding SowingPlots}" 
                          SelectedItem="{Binding SelectedPlot}"
                          DisplayMemberPath="SowingPlot_ID"
                          Margin="0,0,0,15" Padding="5"/>

                <TextBlock Text="Валовый вес (кг):" Margin="0,0,0,5"/>
                <TextBox Text="{Binding EditWeight, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0,0,0,20" Padding="5"/>

                <Button Content="Добавить" Command="{Binding AddCommand}" Padding="10,5" Margin="0,0,0,10" Background="#2196F3" Foreground="White"/>
                <Button Content="Сохранить" Command="{Binding SaveCommand}" Padding="10,5" Margin="0,0,0,10" Background="#4CAF50" Foreground="White"/>
                <Button Content="Удалить" Command="{Binding DeleteCommand}" Padding="10,5" Margin="0,0,0,10" Background="#f44336" Foreground="White"/>
                <Button Content="Отмена" Command="{Binding CancelCommand}" Padding="10,5" Background="#9E9E9E" Foreground="White"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>