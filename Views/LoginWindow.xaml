<Window x:Class="BeerZdec.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BeerZdec.Views"
        mc:Ignorable="d"
        Title="LoginWindow" Height="250" Width="300">
    <StackPanel Margin="20">
        <TextBlock Text="Логин:" Margin="0,0,0,5"/>
        <TextBox x:Name="LoginTextBox" Margin="0,0,0,15"/>

        <TextBlock Text="Пароль:" Margin="0,0,0,5"/>
        <PasswordBox x:Name="PasswordBox" Margin="0,0,0,20"/>

        <Button Content="Войти" Click="LoginButton_Click" Margin="0,0,0,10"/>
        <Button Content="Регистрация" Click="RegisterButton_Click"/>
    </StackPanel>
</Window>
