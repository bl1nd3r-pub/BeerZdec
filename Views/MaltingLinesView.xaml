<UserControl x:Class="BeerZdec.Views.MaltingLinesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BeerZdec.Views"
             mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Таблица линий -->
        <GroupBox Grid.Column="0" Header="Линии солодовни" Margin="0,0,10,0">
            <DataGrid ItemsSource="{Binding MaltingLines}" 
                      SelectedItem="{Binding SelectedLine}"
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding MaltingLine_ID}" Width="50"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding MaltingLine_CurStatus}" Width="*"/>
                    <DataGridTextColumn Header="Зона размещения" Binding="{Binding MaltingLine_LocationZone}" Width="150"/>
                    <DataGridTextColumn Header="Вместимость" Binding="{Binding MaltingLine_TotalCapacity}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Форма редактирования -->
        <GroupBox Grid.Column="1" Header="Редактирование" Margin="10,0,0,0">
            <StackPanel Margin="10">
                <TextBlock Text="Статус линии:" Margin="0,0,0,5"/>
                <TextBox Text="{Binding EditStatus, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0,0,0,10" Padding="5"/>

                <TextBlock Text="Зона размещения:" Margin="0,0,0,5"/>
                <TextBox Text="{Binding EditZone, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0,0,0,10" Padding="5"/>

                <TextBlock Text="Общая вместимость:" Margin="0,0,0,5"/>
                <TextBox Text="{Binding EditCapacity, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0,0,0,20" Padding="5"/>

                <Button Content="Добавить" 
                        Command="{Binding AddCommand}"
                        Padding="10,5" Margin="0,0,0,10"
                        Background="#2196F3" Foreground="White"/>

                <Button Content="Сохранить" 
                        Command="{Binding SaveCommand}"
                        Padding="10,5" Margin="0,0,0,10"
                        Background="#4CAF50" Foreground="White"/>

                <Button Content="Удалить" 
                        Command="{Binding DeleteCommand}"
                        Padding="10,5" Margin="0,0,0,10"
                        Background="#f44336" Foreground="White"/>

                <Button Content="Отмена" 
                        Command="{Binding CancelCommand}"
                        Padding="10,5"
                        Background="#9E9E9E" Foreground="White"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>